# Tokens for the rules target (AFL/libFuzzer dictionary format).
kw_if="if "
kw_then=" then "
kw_else=" else "
kw_and=" and "
kw_or=" or "
kw_not="not "
kw_in=" in "
kw_true="true"
kw_false="false"
eq=" == "
ne=" != "
le=" <= "
ge=" >= "
lt=" < "
gt=" > "
plus=" + "
minus=" - "
times=" * "
div=" / "
mod=" % "
neg="-"
dot="."
paren="("
paren_close=")"
list="["
list_close="]"
comma=", "
string="\"s\""
escape_quote="\\\""
escape_n="\\n"
number="1.5"
call="max("
comment="# c"
