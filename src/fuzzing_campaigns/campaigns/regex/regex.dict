# Tokens for the regex target (AFL/libFuzzer dictionary format).
star="*"
plus="+"
question="?"
alt="|"
group="("
group_close=")"
group_empty="()"
class_open="["
class_neg="[^"
class_close="]"
range="a-z"
digit="\\d"
word="\\w"
space="\\s"
not_digit="\\D"
escaped_dot="\\."
escaped_brace="\\{"
escaped_dash="\\-"
anchor_start="^"
anchor_end="$"
any="."
rep_exact="{3}"
rep_open="{2,}"
rep_range="{1,5}"
rep_zero="{0}"
rep_big="{1000}"
lazy="*?"
ext="(?"
