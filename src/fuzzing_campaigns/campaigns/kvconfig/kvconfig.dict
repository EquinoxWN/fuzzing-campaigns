# Tokens for the kvconfig target (AFL/libFuzzer dictionary format).
section_open="["
section_close="]"
assign=" = "
quote="\""
escape_quote="\\\""
escape_backslash="\\\\"
escape_n="\\n"
escape_t="\\t"
escape_r="\\r"
escape_u="\\u00e9"
escape_u_short="\\u12"
comment_hash="#"
comment_semicolon=";"
newline="\x0a"
crlf="\x0d\x0a"
name_dotted="a.b-c_d"
